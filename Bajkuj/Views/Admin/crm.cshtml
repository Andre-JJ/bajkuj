@{
    ViewData["Title"] = T("CRM") + " – Bajkuj v meste";
    var contacts = new[]
    {
        new { Name = "Eva Malá", Email = "eva.mala@example.com", Stage = "Nový kontakt", Interest = "Mestský bicykel na dochádzanie", Note = "Zaujíma ju mesačný prenájom od decembra.", Next = "Poslať ponuku na Kellys Avenue 30." },
        new { Name = "Jana Nováková", Email = "jana.novakova@example.com", Stage = "Čaká na podpis", Interest = "Rezervácia bicykla BK-046", Note = "Zmluva ZML-2025-043 je pripravená na podpis.", Next = "Potvrdiť termín prevzatia bicykla." },
        new { Name = "Peter Kováč", Email = "peter.kovac@example.com", Stage = "Aktívny nájomca", Interest = "Prenájom bicykla BK-023", Note = "Dohodnuté vrátenie na výdajnom mieste.", Next = "Overiť úhradu P-1051 pri vrátení." }
    };
}
<div class="intro"><h1>CRM</h1><p>@T("Kontakty a ďalšie kroky od prvého dopytu po aktívny prenájom")</p></div>
<div class="filter-bar">
    <label for="crm-filter">@T("Fáza kontaktu")</label>
    <select id="crm-filter" data-filter="crm-contacts">
        <option value="">@T("Všetky kontakty")</option><option value="Nový kontakt">@T("Nový kontakt")</option><option value="Čaká na podpis">@T("Čaká na podpis")</option><option value="Aktívny nájomca">@T("Aktívny nájomca")</option>
    </select>
</div>
<ul class="prototype-grid" id="crm-contacts">
    @foreach (var contact in contacts)
    {
        <li class="panel content-panel record-card" data-filter-value="@contact.Stage">
            <div class="record-heading"><span class="contract-status" data-status="@contact.Stage">@T(contact.Stage)</span></div>
            <h2>@contact.Name</h2><p class="quiet">@contact.Email</p>
            <dl class="preview-facts">
                <div><dt>@T("Záujem")</dt><dd>@T(contact.Interest)</dd></div>
                <div><dt>@T("Posledná poznámka")</dt><dd>@T(contact.Note)</dd></div>
                <div><dt>@T("Ďalší krok")</dt><dd>@T(contact.Next)</dd></div>
            </dl>
        </li>
    }
</ul>
<div class="preview-links">
    <a asp-route="prototype" asp-route-role="admin" asp-route-section="zaujemcovia">@T("Záujemcovia")</a>
    <a asp-route="prototype" asp-route-role="admin" asp-route-section="najomcovia">@T("Nájomcovia")</a>
    <a asp-route="prototype" asp-route-role="admin" asp-route-section="komunikacia">@T("Konverzácie")</a>
</div>
