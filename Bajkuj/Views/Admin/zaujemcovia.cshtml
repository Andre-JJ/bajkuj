@using System.Globalization
@{
    ViewData["Title"] = T("Záujemcovia") + " – Bajkuj v meste";
    var slovak = CultureInfo.GetCultureInfo("sk-SK");
    var rentalsByApplicant = PrototypeContract.CreateMockContracts()
        .OrderByDescending(contract => contract.Start)
        .ToLookup(contract => contract.TenantId);
    var applicants = rentalsByApplicant.Select(group => (Id: group.Key, Name: group.First().Tenant))
        .Append((Id: 8, Name: "Eva Malá"))
        .OrderBy(applicant => applicant.Name, StringComparer.Create(slovak, ignoreCase: true));
}

<div class="intro"><h1>@T("Záujemcovia")</h1></div>
<ul class="applicant-list">
    @foreach (var applicant in applicants)
    {
        var rentals = rentalsByApplicant[applicant.Id];

        <li>
            <details class="panel applicant">
                <summary>@applicant.Name</summary>
                @if (rentals.Any())
                {
                    <div class="table-wrap">
                        <table>
                            <caption class="applicant-caption">@T("Prenájmy – {0}", applicant.Name)</caption>
                            <thead>
                                <tr>
                                    <th scope="col">@T("Číslo zmluvy")</th>
                                    <th scope="col">@T("Bicykel")</th>
                                    <th scope="col">@T("Od")</th>
                                    <th scope="col">@T("Do")</th>
                                    <th scope="col">@T("Stav zmluvy")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rental in rentals)
                                {
                                    <tr>
                                        <td>@rental.Number</td>
                                        <td>@rental.Bicycle</td>
                                        <td><time datetime="@rental.Start.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@rental.Start.ToString("d")</time></td>
                                        <td><time datetime="@rental.End.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@rental.End.ToString("d")</time></td>
                                        <td><span class="contract-status" data-status="@rental.Status">@T(rental.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="applicant-empty">@T("Zatiaľ bez prenájmov.")</p>
                }
            </details>
        </li>
    }
</ul>
