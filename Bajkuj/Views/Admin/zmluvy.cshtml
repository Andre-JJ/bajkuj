@{
    ViewData["Title"] = T("Zmluvy") + " – Bajkuj v meste";
    var contracts = PrototypeContract.CreateMockContracts();
}

<div class="intro"><h1 id="contracts-heading">@T("Zmluvy")</h1></div>
<section class="panel contract-panel" aria-labelledby="contracts-heading">
    <div class="table-wrap">
        <table aria-labelledby="contracts-heading">
            <thead>
                <tr>
                    <th scope="col">@T("Číslo zmluvy")</th>
                    <th scope="col">@T("Nájomca")</th>
                    <th scope="col">@T("Bicykel")</th>
                    <th scope="col">@T("Začiatok prenájmu")</th>
                    <th scope="col">@T("Koniec prenájmu")</th>
                    <th scope="col">@T("Stav")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contract in contracts)
                {
                    <tr>
                        <th scope="row">@contract.Number</th>
                        <td>@contract.Tenant</td>
                        <td>@contract.Bicycle</td>
                        <td><time datetime="@contract.Start.ToString("yyyy-MM-dd")">@contract.Start.ToString("d")</time></td>
                        <td><time datetime="@contract.End.ToString("yyyy-MM-dd")">@contract.End.ToString("d")</time></td>
                        <td><span class="contract-status" data-status="@contract.Status">@T(contract.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
<section class="preview-stack agreement-list" aria-labelledby="agreement-heading">
    <h2 id="agreement-heading">@T("Náhľady zmlúv")</h2>
    @foreach (var contract in contracts)
    {
        <details class="panel disclosure" id="@contract.Number">
            <summary>@contract.Number · @contract.Tenant</summary>
            <div class="disclosure-body"><partial name="_PrototypeAgreement" model="contract" /></div>
        </details>
    }
</section>
