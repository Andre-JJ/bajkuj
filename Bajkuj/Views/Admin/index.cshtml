@{
    Layout = "_PrototypeLayout";
    ViewData["PrototypeRole"] = "admin";
    ViewData["PrototypeSection"] = "index";
    ViewData["Title"] = T("Domov") + " – Bajkuj v meste";
    var today = PrototypeContract.Today;
    var upcomingContracts = PrototypeContract.CreateMockContracts()
        .Where(contract => contract.Status == "Aktívna" && contract.End >= today)
        .OrderBy(contract => contract.End)
        .Take(5);
}

<div class="intro">
  <h1>@T("Domov")</h1>
  <p>@T("Prehľad dôležitých informácií o systéme.")</p>
</div>
<ul class="stats" aria-label="@T("Štatistiky")">
  <li class="stat"><span class="stat-icon"><span class="icon icon-bike" aria-hidden="true"></span></span><div><strong>120</strong><p>@T("Všetky bicykle")</p></div></li>
  <li class="stat"><span class="stat-icon"><span class="icon icon-bike" aria-hidden="true"></span></span><div><strong>78</strong><p>@T("Dostupných")</p></div></li>
  <li class="stat"><span class="stat-icon"><span class="icon icon-bike" aria-hidden="true"></span></span><div><strong>42</strong><p>@T("Prenajatých")</p></div></li>
  <li class="stat"><span class="stat-icon"><span class="icon icon-people people-icon" aria-hidden="true"></span></span><div><strong>12</strong><p>@T("Čaká na schválenie")</p></div></li>
</ul>
<div class="panels">
  <section class="panel" aria-labelledby="activity-heading">
    <header>
      <span class="icon icon-history" aria-hidden="true"></span><h2 id="activity-heading">@T("Posledná aktivita")</h2>
      <a class="all" asp-route="prototype" asp-route-role="admin" asp-route-section="aktivita">@T("Zobraziť všetko") <span class="icon icon-arrow" aria-hidden="true"></span></a>
    </header>
    <partial name="_PrototypeActivityList" model="PrototypeActivity.Recent.Take(5)" />
  </section>
  <section class="panel" aria-labelledby="contracts-heading">
    <header>
      <span class="icon icon-calendar" aria-hidden="true"></span><h2 id="contracts-heading">@T("Nadchádzajúce konce zmlúv")</h2>
      <a class="all" asp-route="prototype" asp-route-role="admin" asp-route-section="zmluvy">@T("Zobraziť všetko") <span class="icon icon-arrow" aria-hidden="true"></span></a>
    </header>
    <div class="table-wrap">
      <table aria-labelledby="contracts-heading">
        <thead><tr><th scope="col">@T("Nájomca")</th><th scope="col">@T("Bicykel")</th><th scope="col">@T("Dátum konca")</th><th scope="col" aria-label="@T("Zostávajúci čas")"></th></tr></thead>
        <tbody>
          @foreach (var contract in upcomingContracts)
          {
            var days = contract.End.DayNumber - today.DayNumber;
            var remaining = days switch
            {
                0 => T("dnes"),
                1 => T("zajtra"),
                <= 4 => T("za {0} dni", days),
                _ => T("za {0} dní", days)
            };
            <tr>
              <td>@contract.Tenant</td><td>@contract.Bicycle</td>
              <td><time datetime="@contract.End.ToString("yyyy-MM-dd")">@contract.End.ToString("d")</time></td>
              <td><span class="days">@remaining</span></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
</div>
<section class="status" aria-labelledby="status-heading">
  <span class="status-icon"><span class="icon icon-info" aria-hidden="true"></span></span>
  <div><h2 id="status-heading">@T("Všetko funguje tak, ako má!")</h2><p>@T("Systém je aktuálne bez upozornení.")</p></div>
  <div class="skyline" aria-hidden="true"></div>
</section>
