@model IReadOnlyList<BikeStock>
@{
    Layout = null;
    ViewData["Title"] = T("Bajkuj v meste – prenájom bicyklov");
    var userHome = Url.RouteUrl("prototype", new { role = "user", section = "index" });
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var bikeTypes = Model.GroupBy(stock => stock.Bike.Typ).OrderBy(type => T(type.Key)).ToList();
    var selectedBike = Model.FirstOrDefault()?.Bike;
    var questions = new (string Question, string Answer)[]
    {
        ("Na ako dlho si môžem prenajať bicykel?", "Vyberte si jeden mesiac alebo jeden rok. Pri každom dostupnom modeli uvidíte obe ceny."),
        ("Ako zaplatím?", "Celkovú cenu uvidíte pred potvrdením prenájmu. Ak je online platba kartou dostupná, pokračujte na platobnú stránku."),
        ("Môžem zrušiť prenájom?", "V časti Moje prenájmy nájdete možnosť zrušenia aktívneho prenájmu."),
        ("Kde si bicykel vyzdvihnem alebo vrátim?", "Miesto a čas vyzdvihnutia a vrátenia doplníme po ich potvrdení."),
        ("Čo ak bicykel potrebuje opravu?", "Pokyny k servisu a kontakt doplníme po ich potvrdení.")
    };
}
<!doctype html>
<html lang="@Language">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@T("Prezrite si dostupné bicykle a vyberte si bicykel na prenájom v Bajkuj v meste.")">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/prototype/logo.png" asp-append-version="true">
    <link rel="stylesheet" href="~/prototype/prototype.css" asp-append-version="true">
    <link rel="stylesheet" href="~/prototype/landing.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/profile-menu.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/actions.css" asp-append-version="true">
    <script src="~/prototype/bike-photos.js" asp-append-version="true" defer></script>
</head>
<body class="landing">
    <a class="skip-link" href="#content">@T("Preskočiť na obsah")</a>
    <header class="landing-header">
        <div class="landing-header-start">
            <a class="landing-brand" asp-controller="Home" asp-action="Index" aria-label="@T("Bajkuj v meste – úvod")">
                <img src="~/prototype/logo.png" asp-append-version="true" alt="">
                <span>BAJKUJ <span>V MESTE</span></span>
            </a>
            <partial name="_LanguageSwitcher" />
        </div>
        <nav aria-label="@T("Hlavná navigácia")">
            <a href="#dostupne-bicykle">@T("Dostupné bicykle")</a>
            <a href="#ako-to-funguje">@T("Ako to funguje")</a>
            <a href="#caste-otazky">@T("Časté otázky")</a>
            @if (isSignedIn)
            {
                <a class="landing-button" href="@userHome">@T("Domov")</a>
                <partial name="_ProfileMenu" model="@("user")" />
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@userHome">@T("Prihlásiť sa")</a>
                <a class="landing-button" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@userHome">@T("Vytvoriť účet")</a>
            }
        </nav>
    </header>
    <main id="content">
        <section class="landing-hero" aria-labelledby="hero-heading">
            <div class="landing-hero-copy">
                <h1 id="hero-heading">@T("Mesto je bližšie na bicykli.")</h1>
                <p>@T("Prenajmite si bicykel na mesiac alebo na rok. Vyberte si model na cestu do práce, na nákupy alebo na víkend.")</p>
                <a class="landing-button" href="#dostupne-bicykle">@T("Prezrieť bicykle") <span aria-hidden="true">↓</span></a>
            </div>
            <img class="landing-hero-photo" src="~/prototype/landing-trnava.jpg" asp-append-version="true"
                 width="960" height="640" alt="@T("Žltý bicykel na dláždenej ulici")">
        </section>
        <section class="landing-band" id="dostupne-bicykle" aria-labelledby="available-bikes-heading">
            <div class="landing-section">
                <div class="landing-section-heading">
                    <h2 id="available-bikes-heading">@T("Dostupné bicykle")</h2>
                    <p class="landing-stock-count">@T("Dostupné dnes: {0}", Model.Sum(stock => stock.AvailableUnits))</p>
                </div>
                @if (TempData["LandingRentalNotice"] is string notice)
                {
                    <p class="landing-rental-notice" role="status">@T(notice)</p>
                }
                @if (selectedBike is not null)
                {
                    <div class="landing-rental-grid">
                        <section class="landing-rental-panel" aria-labelledby="stock-heading">
                            <h3 id="stock-heading">@T("Vyberte model")</h3>
                            <ul class="landing-stock-models" aria-labelledby="stock-heading">
                                @foreach (var stock in Model)
                                {
                                    var bike = stock.Bike;
                                    <li>
                                        <button class="landing-stock-model" type="button" data-select-bike="@bike.Id"
                                                aria-label="@bike.Model, @T(bike.Typ), @T("Voľné kusy: {0}", stock.AvailableUnits)"
                                                aria-pressed="@(bike.Id == selectedBike.Id ? "true" : "false")" disabled>
                                            @if (bike.PhotoPath is string photo)
                                            {
                                                <img src="@Url.Content(photo)" alt="" loading="lazy">
                                            }
                                            else
                                            {
                                                <span class="icon icon-bike" aria-hidden="true"></span>
                                            }
                                            <span class="landing-stock-model-details">
                                                <strong>@bike.Model</strong>
                                                <span>@T(bike.Typ)</span>
                                            </span>
                                            <span class="landing-model-units">@stock.AvailableUnits</span>
                                        </button>
                                    </li>
                                }
                            </ul>
                            <dl class="landing-bike-types">
                                @foreach (var type in bikeTypes)
                                {
                                    <div><dt>@T(type.Key)</dt><dd>@type.Sum(stock => stock.AvailableUnits)</dd></div>
                                }
                            </dl>
                        </section>
                        <section class="landing-rental-panel" aria-label="@T("Prenajať bicykel")">
                            <form class="landing-rental-form" asp-route="start-rental" method="get"
                                  aria-describedby="@(isSignedIn ? null : "rental-account-note")">
                                <div data-bike-picker-fallback>
                                    <label for="landing-bike">@T("Vyberte si bicykel")</label>
                                    <select id="landing-bike" name="bikeId" required>
                                        @foreach (var type in bikeTypes)
                                        {
                                            <optgroup label="@T(type.Key)">
                                                @foreach (var stock in type)
                                                {
                                                    var bike = stock.Bike;
                                                    <option value="@bike.Id" selected="@(bike.Id == selectedBike.Id)"
                                                            data-photo="@(bike.PhotoPath is string photo ? Url.Content(photo) : null)"
                                                            data-model="@bike.Model" data-stock="@T("Voľné kusy: {0}", stock.AvailableUnits)"
                                                            data-month-price="@PrototypeOperations.Money(bike.CenaZaMesiac)"
                                                            data-year-price="@PrototypeOperations.Money(bike.CenaZaRok)">
                                                        @T("{0} · {1} / mesiac · {2} / rok", bike.Model, PrototypeOperations.Money(bike.CenaZaMesiac), PrototypeOperations.Money(bike.CenaZaRok))
                                                    </option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </div>
                                <div class="landing-model-photo" data-bike-preview hidden>
                                    <span class="icon icon-bike" data-bike-placeholder aria-hidden="true"></span>
                                    <a data-bike-photo hidden><img alt=""></a>
                                </div>
                                <div data-bike-details aria-live="polite" aria-atomic="true" hidden>
                                    <h3 data-bike-model></h3>
                                    <p class="quiet" data-bike-stock></p>
                                    <dl class="landing-prices">
                                        <div><dt>@T("Cena za mesiac")</dt><dd data-bike-month-price></dd></div>
                                        <div><dt>@T("Cena za rok")</dt><dd data-bike-year-price></dd></div>
                                    </dl>
                                </div>
                                <button class="landing-button" type="submit">@T("Prenajať bicykel") <span aria-hidden="true">→</span></button>
                                @if (!isSignedIn)
                                {
                                    <p id="rental-account-note" class="landing-account-note">@T("Na prenájom bicykla potrebujete účet.")</p>
                                }
                            </form>
                        </section>
                    </div>
                }
                else
                {
                    <p>@T("Momentálne nie sú dostupné žiadne bicykle.")</p>
                }
            </div>
        </section>
        <section class="landing-section" id="ako-to-funguje" aria-labelledby="how-heading">
            <h2 id="how-heading">@T("Ako to funguje")</h2>
            <div class="landing-steps">
                <article><h3>@T("Vyberte si bicykel")</h3><p>@T("Porovnajte dostupné modely a ceny na mesiac alebo na rok.")</p></article>
                <article><h3>@T("Prihláste sa alebo sa zaregistrujte")</h3><p>@T("Vo svojom účte si môžete pozrieť a spravovať prenájmy.")</p></article>
                <article><h3>@T("Potvrďte prenájom")</h3><p>@T("Pred potvrdením si skontrolujte model, dĺžku prenájmu a celkovú cenu.")</p></article>
            </div>
        </section>
        <section class="landing-band" id="caste-otazky" aria-labelledby="faq-heading">
            <div class="landing-section">
                <h2 id="faq-heading">@T("Časté otázky")</h2>
                <div class="landing-faq">
                    @foreach (var (question, answer) in questions)
                    {
                        <details>
                            <summary>@T(question)</summary>
                            <p>@T(answer)</p>
                        </details>
                    }
                </div>
            </div>
        </section>
    </main>
    <footer class="landing-footer @(isSignedIn ? "landing-footer-signed-in" : null)">
        <p>Bajkuj v meste</p>
        @if (!isSignedIn)
        {
            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@userHome">@T("Už máte účet? Prihláste sa")</a>
        }
    </footer>
    <partial name="_BikePhotoDialog" />
</body>
</html>
