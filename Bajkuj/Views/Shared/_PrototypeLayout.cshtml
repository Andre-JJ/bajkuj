@{
    var role = ViewData["PrototypeRole"] as string ?? "admin";
    var section = ViewData["PrototypeSection"] as string ?? "index";
    var isAdminPreview = role == "admin";
    var navigation = isAdminPreview ? PrototypeNavigation.Admin : PrototypeNavigation.User;
    var currentPath = Context.Request.PathBase.Add(Context.Request.Path);
    var userSection = PrototypeNavigation.User.Any(item => item.Section == section) ? section : "index";
    var adminPreviewUrl = section != "index"
        ? Url.RouteUrl("prototype", new { role = "admin", section })
        : Url.RouteUrl("prototype", new { role = "admin", section = "index" });
}
<!doctype html>
<html lang="@Language">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/prototype/logo.png" asp-append-version="true">
    <link rel="stylesheet" href="~/prototype/prototype.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/profile-menu.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/actions.css" asp-append-version="true">
    <script src="~/prototype/prototype.js" asp-append-version="true" defer></script>
    <script src="~/prototype/bike-photos.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <a class="brand brand-home" asp-controller="Home" asp-action="Index" aria-label="@T("Bajkuj v meste – úvodná stránka")">
                <img class="brand-logo" src="~/prototype/logo.png" asp-append-version="true" alt="">
                <p class="brand-name">BAJKUJ <span>V MESTE</span></p>
            </a>
            <button class="mobile-menu" type="button" aria-expanded="true" aria-controls="prototype-navigation" hidden>Menu · @T(navigation.FirstOrDefault(item => item.Section == section)?.Label ?? "")</button>
            <nav id="prototype-navigation" aria-label="@T("Hlavná navigácia")">
                <ul class="menu">
                    @foreach (var item in navigation.Where(item => item.ShowInMenu))
                    {
                        var href = Url.RouteUrl("prototype", new { role, section = item.Section });
                        <li>
                            <a href="@href" aria-current="@(item.Section == section ? "page" : null)" aria-label="@T(item.Label)">
                                <span class="icon icon-@item.Icon" aria-hidden="true"></span><span>@T(item.Label)</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="sign-out" asp-area="Identity" asp-page="/Account/Login"
                   asp-route-returnUrl="@currentPath" aria-label="@T("Prihlásiť sa")">
                    <span class="icon icon-account" aria-hidden="true"></span><span>@T("Prihlásiť sa")</span>
                </a>
            }
        </aside>
        <div class="workspace">
            <header class="topbar">
                <partial name="_LanguageSwitcher" />
                <partial name="_PrototypeNotifications" model="isAdminPreview" />
                <span class="topbar-divider" aria-hidden="true"></span>
                <div class="account">
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <span class="account-name" data-profile-name>@(isAdminPreview ? "Martin Novotný" : "Peter Kováč")</span>
                        <span class="icon icon-account" aria-hidden="true"></span>
                    }
                    @if (User.IsInRole(Bajkuj.Data.AdminAccounts.Role))
                    {
                        <details class="role-picker" name="account-panels" data-view="@role">
                            <summary>
                                <span class="icon @(isAdminPreview ? "icon-chart" : "icon-person")" aria-hidden="true"></span>
                                <span>@T(isAdminPreview ? "Pohľad správcu" : "Pohľad používateľa")</span>
                            </summary>
                            <div class="role-options">
                                <a href="@(isAdminPreview ? currentPath.Value : adminPreviewUrl)"
                                   aria-current="@(isAdminPreview ? "page" : null)">@T("Pohľad správcu")</a>
                                <a asp-route="prototype" asp-route-role="user" asp-route-section="@userSection"
                                   aria-current="@(!isAdminPreview ? "page" : null)">@T("Pohľad používateľa")</a>
                            </div>
                        </details>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <partial name="_ProfileMenu" model="role" />
                    }
                </div>
            </header>
            <main>
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_BikePhotoDialog" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
