@model bool
@{
    var isAdmin = Model;
    var today = PrototypeContract.Today;
    var contracts = PrototypeContract.CreateMockContracts()
        .Where(contract => isAdmin || contract.TenantId == PrototypeOperations.PreviewTenantId).ToList();
    var upcoming = contracts.Where(contract => contract.Status == "Aktívna" && contract.End >= today && contract.End <= today.AddDays(14))
        .OrderBy(contract => contract.End);
    var ended = contracts.Where(contract => contract.Status == "Ukončená")
        .OrderByDescending(contract => contract.End).Take(1);
    var role = isAdmin ? "admin" : "user";
}
<details class="notification" data-notification-menu data-role="@role">
    <summary aria-label="@T("Oznámenia")"><span class="icon icon-bell" aria-hidden="true"></span><span class="notification-dot" aria-hidden="true"></span></summary>
    <section class="notification-panel" aria-label="@T("Oznámenia")">
        <h2>@T("Oznámenia")</h2>
        <ul>
            @foreach (var contract in upcoming)
            {
                <li data-notification="renewal" data-days-until-end="@(contract.End.DayNumber - today.DayNumber)">
                    <strong>@T(isAdmin ? "Blíži sa koniec prenájmu" : "Chcete predĺžiť prenájom?")</strong>
                    <p>@contract.Bicycle · @T("koniec {0}", contract.End.ToString("d"))</p>
                    <a asp-route="prototype" asp-route-role="@role" asp-route-section="zmluvy" asp-fragment="@contract.Number">@T("Otvoriť zmluvu")</a>
                </li>
            }
            @foreach (var contract in ended)
            {
                <li data-notification="ended">
                    <strong>@T("Prenájom sa skončil")</strong>
                    <p>@contract.Bicycle · @T("skončil {0}", contract.End.ToString("d"))</p>
                    <a asp-route="prototype" asp-route-role="@role" asp-route-section="zmluvy" asp-fragment="@contract.Number">@T("Otvoriť zmluvu")</a>
                </li>
            }
        </ul>
        <p class="quiet" data-notification-empty hidden>@T("Nemáte žiadne oznámenia.")</p>
        <a asp-route="prototype" asp-route-role="@role" asp-route-section="nastavenia">@T("Nastavenia oznámení")</a>
    </section>
</details>
