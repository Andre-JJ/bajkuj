@model PrototypeContract
@{
    var payments = PrototypeOperations.Payments.Where(payment => payment.Contract == Model.Number).ToList();
}
<article class="agreement">
    <p class="quiet">@T("Vzorový dokument")</p>
    <h2>@T("Zmluva o prenájme bicykla č. {0}", Model.Number)</h2>
    <dl class="preview-facts">
        <div><dt>@T("Prenajímateľ")</dt><dd>Bajkuj v meste</dd></div>
        <div><dt>@T("Nájomca")</dt><dd>@Model.Tenant</dd></div>
        <div><dt>@T("Predmet prenájmu")</dt><dd>@T("Bicykel") @Model.Bicycle</dd></div>
        <div><dt>@T("Doba prenájmu")</dt><dd>@Model.Start.ToString("d") – @Model.End.ToString("d")</dd></div>
        <div><dt>@T("Stav zmluvy")</dt><dd>@T(Model.Status)</dd></div>
    </dl>
    <h3>@T("Úhrada za prenájom")</h3>
    @if (payments.Count > 0)
    {
        <p>@T("Suma podľa ukážkového rozpisu platieb je") <strong>@PrototypeOperations.Money(payments.Sum(payment => payment.Amount))</strong>.</p>
        <ul>
            @foreach (var payment in payments)
            {
                <li>@payment.Reference · @PrototypeOperations.Money(payment.Amount) · @T(payment.Status)</li>
            }
        </ul>
    }
    else
    {
        <p>@T("Výška nájomného a splatnosť sa dohodnú pred prevzatím bicykla.")</p>
    }
    <h3>@T("Prevzatie a vrátenie")</h3>
    <p>@T("Pri prevzatí obe strany zaznamenajú stav bicykla a príslušenstva. Nájomca vráti bicykel na dohodnutom výdajnom mieste do konca prenájmu a nahlási zistené poškodenia.")</p>
    <h3>@T("Podpisy")</h3>
    <div class="agreement-signatures"><span>@T("Prenajímateľ")</span><span>@T("Nájomca")</span></div>
</article>
