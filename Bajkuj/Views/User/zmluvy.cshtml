@{
    ViewData["Title"] = T("Zmluvy") + " – Bajkuj v meste";
    var contracts = PrototypeContract.CreateMockContracts()
        .Where(contract => contract.TenantId == PrototypeOperations.PreviewTenantId)
        .OrderByDescending(contract => contract.Start).ToList();
}
<div class="intro"><h1>@T("Zmluvy")</h1><p>@T("Aktuálne prenájmy, termíny vrátenia a história zmlúv")</p></div>
<div class="user-overview">
    <div class="preview-stack">
        @foreach (var contract in contracts)
        {
            <article class="panel content-panel record-card">
                <div class="record-heading"><span class="quiet">@contract.Number</span><span class="contract-status" data-status="@contract.Status">@T(contract.Status)</span></div>
                <h2>@T("Prenájom bicykla {0}", contract.Bicycle)</h2>
                <p>@contract.Start.ToString("d") – @contract.End.ToString("d")</p>
                <details class="disclosure agreement-disclosure" id="@contract.Number">
                    <summary>@T("Zobraziť vzor zmluvy")</summary>
                    <div class="disclosure-body"><partial name="_PrototypeAgreement" model="contract" /></div>
                </details>
            </article>
        }
    </div>
    <aside class="panel content-panel record-card rental-help">
        <h2>@T("Pred koncom prenájmu")</h2>
        <p>@T("Potrebujete bicykel dlhšie? V správe uveďte číslo zmluvy a navrhovaný nový termín vrátenia.")</p>
        <a asp-route="prototype" asp-route-role="user" asp-route-section="komunikacia">@T("Otvoriť komunikáciu")</a>
        <h2>@T("Úhrady")</h2>
        <p>@T("Splatnosť a stav úhrad nájdete v prehľade platieb.")</p>
        <a asp-route="prototype" asp-route-role="user" asp-route-section="platby">@T("Moje platby")</a>
    </aside>
</div>
