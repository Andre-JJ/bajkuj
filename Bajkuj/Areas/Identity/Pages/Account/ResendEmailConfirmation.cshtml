@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = T("Znova odoslať potvrdzovací e-mail");
}
<h1>@ViewData["Title"]</h1>
<p>@T("Zadajte e-mailovú adresu svojho účtu.")</p>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-group">
        <label asp-for="Input.Email">@T("E-mail")</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" required>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <button type="submit">@T("Odoslať potvrdzovací e-mail")</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
